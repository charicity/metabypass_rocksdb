+
+  IOStatus Append(const ROCKSDB_NAMESPACE::Slice& data,
+                  const IOOptions& options,
+                  const ROCKSDB_NAMESPACE::DataVerificationInfo& verification,
+                  IODebugContext* dbg) override {
+    return meter_->Measure(append_operation_, data.size(), [&] {
+      return target()->Append(data, options, verification, dbg);
+    });
+  }
+
+  IOStatus Sync(const IOOptions& options, IODebugContext* dbg) override {
+    return meter_->Measure(BackupIoOperation::kFileSync, 0,
+                           [&] { return target()->Sync(options, dbg); });
+  }
+
+  IOStatus Fsync(const IOOptions& options, IODebugContext* dbg) override {
+    return meter_->Measure(BackupIoOperation::kFileFsync, 0,
