+namespace wal = ROCKSDB_NAMESPACE::metabypass::wal_probe;
+
+struct FineTotals {
+  WriteBreakdown api;
+  std::array<FileIoTotals, wal::stage_count> stages{};
+
+  void Add(const wal::Trace& trace, uint64_t count, uint64_t elapsed,
+           const ROCKSDB_NAMESPACE::PerfContext& perf) {
+    api.Add(count, elapsed, perf);
+    uint64_t capacity = 0;
+    for (size_t i = 0; i < trace.size; ++i) {
+      const auto& span = trace.intervals[i];
+      auto& stage = stages[span.stage];
+      ++stage.calls;
+      stage.ns += span.end - span.begin;
+      stage.bytes += span.bytes;
+      if (span.stage == wal::capacity_wait) capacity += span.end - span.begin;
+    }
+    stages[wal::reserve_bookkeeping].ns -= capacity;
+  }
+
+  std::string Fields(bool enabled) const {
+    constexpr const char* names[] = {"operations_wait", "event_build",
+      "reserve_wait", "reserve_bookkeeping", "capacity_wait", "payload_copy",
+      "primary_append", "finish_wait", "finish_bookkeeping", "batch_validation",
+      "error_check", "write_fence_wait", "completed_wait", "completed_bookkeeping"};
+    static_assert(std::size(names) == wal::stage_count);
+    std::ostringstream out;
+    out << (enabled ? ",\"fine_wal\":{" : ",\"fine_wal_reference\":{")
+        << "\"calls\":" << api.calls << ",\"records\":" << api.records
+        << ",\"api_ns\":" << api.api_ns << ",\"wal_ns\":" << api.wal_ns
+        << ",\"memtable_ns\":" << api.memtable_ns;
+    if (!enabled) return out.str() + "}";
+    out << ",\"primary_append_bytes\":" << stages[wal::primary_append].bytes
+        << ",\"stages\":{";
+    for (size_t i = 0; i < stages.size(); ++i) {
+      if (i) out << ",";
+      out << Quote(names[i]) << ":{\"calls\":" << stages[i].calls
+          << ",\"ns\":" << stages[i].ns << "}";
+    }
+    return out.str() + "}}";
+  }
+};
+
+uint64_t ClockP95() {
+  std::array<uint64_t, 1024> costs;
+  for (auto& cost : costs) {
+    auto begin = wal::Clock();
+    cost = wal::Clock() - begin;
+  }
+  std::sort(costs.begin(), costs.end());
+  return costs[972];
+}
+
+class MeasuredPrimaryWal : public ROCKSDB_NAMESPACE::FSWritableFileOwnerWrapper {
+ public:
+  MeasuredPrimaryWal(std::unique_ptr<FSWritableFile> file)
+      : FSWritableFileOwnerWrapper(std::move(file)) {}
+
+  IOStatus Append(const ROCKSDB_NAMESPACE::Slice& data,
+                  const IOOptions& options, IODebugContext* dbg) override {
+    return Measure(data.size(),
+                   [&] { return target()->Append(data, options, dbg); });
+  }
+
+  IOStatus Append(const ROCKSDB_NAMESPACE::Slice& data,
+                  const IOOptions& options,
+                  const ROCKSDB_NAMESPACE::DataVerificationInfo& verification,
+                  IODebugContext* dbg) override {
+    return Measure(data.size(), [&] {
+      return target()->Append(data, options, verification, dbg);
+    });
+  }
+
+ private:
+  template <typename AppendCall>
+  IOStatus Measure(size_t size, AppendCall append) {
+    if (!wal::active) return append();
+    wal::Span span(wal::primary_append, true);
+    auto status = append();
+    span.End(status.ok() ? size : 0);
+    return status;
+  }
+};
+
+class PrimaryWalFileSystem : public FileSystemWrapper {
+ public:
+  PrimaryWalFileSystem(const std::shared_ptr<FileSystem>& fs,
+                      const std::string& db)
+      : FileSystemWrapper(fs), prefix_(db + "/") {}
+
+  const char* Name() const override { return "AcceptancePrimaryWalFileSystem"; }
+
+  IOStatus NewWritableFile(const std::string& path, const FileOptions& options,
+                           std::unique_ptr<FSWritableFile>* file,
+                           IODebugContext* dbg) override {
+    auto status = target()->NewWritableFile(path, options, file, dbg);
+    if (status.ok()) WrapPrimaryWal(path, file);
+    return status;
+  }
+
+  IOStatus ReopenWritableFile(const std::string& path,
+                              const FileOptions& options,
+                              std::unique_ptr<FSWritableFile>* file,
+                              IODebugContext* dbg) override {
+    auto status = target()->ReopenWritableFile(path, options, file, dbg);
+    if (status.ok()) WrapPrimaryWal(path, file);
+    return status;
+  }
+
+  IOStatus ReuseWritableFile(const std::string& path, const std::string& old,
+                             const FileOptions& options,
+                             std::unique_ptr<FSWritableFile>* file,
+                             IODebugContext* dbg) override {
+    auto status = target()->ReuseWritableFile(path, old, options, file, dbg);
+    if (status.ok()) WrapPrimaryWal(path, file);
+    return status;
+  }
+
+ private:
+  void WrapPrimaryWal(const std::string& path,
+                     std::unique_ptr<FSWritableFile>* file) {
+    const size_t suffix = path.find_first_not_of("0123456789", prefix_.size());
+    if (path.compare(0, prefix_.size(), prefix_) == 0 &&
+        suffix != std::string::npos && suffix > prefix_.size() &&
+        path.compare(suffix, std::string::npos, ".log") == 0) {
+      *file = std::make_unique<MeasuredPrimaryWal>(std::move(*file));
+    }
+  }
+
+  const std::string prefix_;
+};
