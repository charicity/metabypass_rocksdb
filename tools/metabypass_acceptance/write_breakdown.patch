+// The writer and sampler use the same mutex as the acknowledged-call snapshot.
+struct WriteBreakdown {
+  uint64_t calls = 0, records = 0, api_ns = 0, wal_ns = 0, memtable_ns = 0;
+
+  void Add(uint64_t count, uint64_t elapsed,
+           const ROCKSDB_NAMESPACE::PerfContext& perf) {
+    ++calls;
+    records += count;
+    api_ns += elapsed;
+    wal_ns += perf.write_wal_time;
+    memtable_ns += perf.write_memtable_time;
+  }
+
+  std::string Fields(uint64_t snapshot_ns) const {
+    return "\"foreground_snapshot_ns\":" + std::to_string(snapshot_ns) +
+           ",\"sampled_calls\":" + std::to_string(calls) +
+           ",\"sampled_records\":" + std::to_string(records) +
+           ",\"sampled_api_ns\":" + std::to_string(api_ns) +
+           ",\"sampled_wal_ns\":" + std::to_string(wal_ns) +
+           ",\"sampled_memtable_ns\":" + std::to_string(memtable_ns);
+  }
+};
+
+struct MirrorWalAppendStats {
+  uint64_t calls = 0, bytes = 0, ns = 0;
+};
+
+class MirrorWalMeter {
+ public:
+  void Record(uint64_t elapsed_ns, size_t bytes) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++stats_.calls;
+    stats_.bytes += bytes;
+    stats_.ns += elapsed_ns;
+  }
+
+  MirrorWalAppendStats Snapshot() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return stats_;
+  }
+
+ private:
+  std::mutex mutex_;
+  MirrorWalAppendStats stats_;
+};
+
+class MeasuredMirrorWal : public ROCKSDB_NAMESPACE::FSWritableFileOwnerWrapper {
+ public:
+  MeasuredMirrorWal(std::unique_ptr<FSWritableFile> file,
+                    std::shared_ptr<MirrorWalMeter> meter)
+      : FSWritableFileOwnerWrapper(std::move(file)), meter_(std::move(meter)) {}
+
+  IOStatus Append(const ROCKSDB_NAMESPACE::Slice& data,
+                  const IOOptions& options, IODebugContext* dbg) override {
+    return Measure(data.size(),
+                   [&] { return target()->Append(data, options, dbg); });
+  }
+
+  IOStatus Append(const ROCKSDB_NAMESPACE::Slice& data,
+                  const IOOptions& options,
+                  const ROCKSDB_NAMESPACE::DataVerificationInfo& verification,
+                  IODebugContext* dbg) override {
+    return Measure(data.size(), [&] {
+      return target()->Append(data, options, verification, dbg);
+    });
+  }
+
+ private:
+  template <typename AppendCall>
+  IOStatus Measure(size_t size, AppendCall append) {
+    const uint64_t start = Now();
+    auto status = append();
+    const uint64_t elapsed = Now() - start;
+    meter_->Record(elapsed, status.ok() ? size : 0);
+    return status;
+  }
+
+  std::shared_ptr<MirrorWalMeter> meter_;
+};
+
+class MirrorWalFileSystem : public FileSystemWrapper {
+ public:
+  MirrorWalFileSystem(const std::shared_ptr<FileSystem>& fs,
+                      const std::string& backup_dir,
+                      std::shared_ptr<MirrorWalMeter> meter)
+      : FileSystemWrapper(fs),
+        prefix_(backup_dir + "/work/"),
+        meter_(std::move(meter)) {}
+
+  const char* Name() const override { return "AcceptanceMirrorWalFileSystem"; }
+
+  IOStatus NewWritableFile(const std::string& path, const FileOptions& options,
+                           std::unique_ptr<FSWritableFile>* file,
+                           IODebugContext* dbg) override {
+    auto status = target()->NewWritableFile(path, options, file, dbg);
+    if (status.ok()) WrapMirrorWal(path, file);
+    return status;
+  }
+
+  IOStatus ReopenWritableFile(const std::string& path,
+                              const FileOptions& options,
+                              std::unique_ptr<FSWritableFile>* file,
+                              IODebugContext* dbg) override {
+    auto status = target()->ReopenWritableFile(path, options, file, dbg);
+    if (status.ok()) WrapMirrorWal(path, file);
+    return status;
+  }
+
+ private:
+  void WrapMirrorWal(const std::string& path,
+                     std::unique_ptr<FSWritableFile>* file) {
+    // Only a numeric WAL basename under the active mirror's work directory.
+    // The primary WAL, checkpoint candidates and PROGRESS remain unwrapped.
+    const size_t suffix = path.find_first_not_of("0123456789", prefix_.size());
+    if (path.compare(0, prefix_.size(), prefix_) == 0 &&
+        suffix != std::string::npos && suffix > prefix_.size() &&
+        path.compare(suffix, std::string::npos, ".log") == 0) {
+      *file = std::make_unique<MeasuredMirrorWal>(std::move(*file), meter_);
+    }
+  }
+
+  const std::string prefix_;
+  std::shared_ptr<MirrorWalMeter> meter_;
+};
