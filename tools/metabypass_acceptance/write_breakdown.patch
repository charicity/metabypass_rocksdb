+class MeasuredMirrorWal : public ROCKSDB_NAMESPACE::FSWritableFileOwnerWrapper {
+ public:
+  MeasuredMirrorWal(std::unique_ptr<FSWritableFile> file,
+                    std::shared_ptr<MirrorWalMeter> meter)
+      : FSWritableFileOwnerWrapper(std::move(file)), meter_(std::move(meter)) {}
+
+  IOStatus Append(const ROCKSDB_NAMESPACE::Slice& data,
+                  const IOOptions& options, IODebugContext* dbg) override {
+    return Measure(data.size(),
+                   [&] { return target()->Append(data, options, dbg); });
+  }
+
+  IOStatus Append(const ROCKSDB_NAMESPACE::Slice& data,
+                  const IOOptions& options,
+                  const ROCKSDB_NAMESPACE::DataVerificationInfo& verification,
+                  IODebugContext* dbg) override {
+    return Measure(data.size(), [&] {
+      return target()->Append(data, options, verification, dbg);
+    });
+  }
+
+ private:
+  template <typename AppendCall>
+  IOStatus Measure(size_t size, AppendCall append) {
+    const uint64_t start = Now();
+    auto status = append();
+    const uint64_t elapsed = Now() - start;
+    meter_->Record(elapsed, status.ok() ? size : 0);
+    return status;
+  }
+
+  std::shared_ptr<MirrorWalMeter> meter_;
+};
