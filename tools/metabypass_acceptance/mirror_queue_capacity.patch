+
+template <typename Options>
+constexpr bool kSplitMirrorQueue = requires(Options options) {
+  options.wal_queue_capacity;
+  options.metadata_queue_capacity;
+};
+
+template <typename Options>
+void SetMirrorQueueCapacity(Options& options, size_t capacity) {
+  if constexpr (kSplitMirrorQueue<Options>) {
+    options.metadata_queue_capacity = capacity / 8;
+    options.wal_queue_capacity = capacity - options.metadata_queue_capacity;
+  } else {
+    options.queue_capacity = capacity;
+  }
+}
+
+template <typename Options>
+size_t MirrorQueueCapacity(const Options& options) {
+  if constexpr (kSplitMirrorQueue<Options>) {
+    return options.wal_queue_capacity + options.metadata_queue_capacity;
+  } else {
+    return options.queue_capacity;
+  }
+}
