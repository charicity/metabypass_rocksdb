+class BackupIoFileSystem : public FileSystemWrapper {
+ public:
+  BackupIoFileSystem(const std::shared_ptr<FileSystem>& fs,
+                     const std::string& backup_dir,
+                     std::shared_ptr<BackupIoMeter> meter)
+      : FileSystemWrapper(fs),
+        prefix_(backup_dir + "/"),
+        meter_(std::move(meter)) {}
+
+  const char* Name() const override { return "AcceptanceBackupIoFileSystem"; }
+
+  IOStatus NewWritableFile(const std::string& path, const FileOptions& options,
+                           std::unique_ptr<FSWritableFile>* file,
+                           IODebugContext* dbg) override {
+    auto status = target()->NewWritableFile(path, options, file, dbg);
+    if (status.ok()) Wrap(path, file);
+    return status;
+  }
+
+  IOStatus ReopenWritableFile(const std::string& path,
+                              const FileOptions& options,
+                              std::unique_ptr<FSWritableFile>* file,
+                              IODebugContext* dbg) override {
+    auto status = target()->ReopenWritableFile(path, options, file, dbg);
+    if (status.ok()) Wrap(path, file);
+    return status;
+  }
+
+  IOStatus NewDirectory(const std::string& path, const IOOptions& options,
+                        std::unique_ptr<FSDirectory>* directory,
+                        IODebugContext* dbg) override {
+    auto status = target()->NewDirectory(path, options, directory, dbg);
+    if (status.ok() &&
+        (std::string_view(prefix_).substr(0, prefix_.size() - 1) == path ||
+         std::string_view(path).starts_with(prefix_))) {
+      *directory = std::make_unique<MeasuredBackupDirectory>(
+          std::move(*directory), meter_);
+    }
+    return status;
+  }
+
+ private:
+  void Wrap(std::string_view path, std::unique_ptr<FSWritableFile>* file) {
+    if (!path.starts_with(prefix_)) return;
+    path.remove_prefix(prefix_.size());
+    BackupIoOperation operation;
+    if (path.starts_with("meta/")) {
+      operation = BackupIoOperation::kMetaAppend;
+    } else if (path.starts_with("private/") || path.starts_with("shared/") ||
+               path.starts_with("shared_checksum/")) {
+      // Shared files use a temporary name until the copy is complete.
+      auto name = path.substr(path.rfind('/') + 1);
+      if (name.ends_with(".tmp")) name.remove_suffix(4);
+      operation = name.ends_with(".log")    ? BackupIoOperation::kWalAppend
+                  : name.ends_with(".sst")  ? BackupIoOperation::kSstAppend
+                  : name.ends_with(".blob") ? BackupIoOperation::kBlobAppend
+                                            : BackupIoOperation::kOtherAppend;
+    } else {
+      return;
+    }
+    *file = std::make_unique<MeasuredBackupFile>(std::move(*file), operation,
+                                                 meter_);
+  }
+
+  const std::string prefix_;
+  std::shared_ptr<BackupIoMeter> meter_;
+};
