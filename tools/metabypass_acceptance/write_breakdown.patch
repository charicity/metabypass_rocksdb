+// These counters are lifetime totals. Jobs can run across sample boundaries;
+// the exporter timestamps when it reads them, not when each job starts.
+std::string WriteBackgroundFields(
+    const ROCKSDB_NAMESPACE::Statistics& statistics,
+    const ROCKSDB_NAMESPACE::MetaBypassStats& mb,
+    const MirrorWalAppendStats& mirror) {
+  using namespace ROCKSDB_NAMESPACE;
+  std::ostringstream out;
+  auto histogram = [&](const char* count_name, const char* time_name,
+                       Histograms type) {
+    HistogramData data{};
+    statistics.histogramData(type, &data);
+    out << ",\"" << count_name << "\":" << data.count << ",\"" << time_name
+        << "\":" << data.sum;
+  };
+  histogram("flush_count", "flush_us", FLUSH_TIME);
+  histogram("compaction_count", "compaction_us", COMPACTION_TIME);
+  histogram("blob_append_count", "blob_append_us",
+            BLOB_DB_BLOB_FILE_WRITE_MICROS);
+  histogram("blob_sync_count", "blob_sync_us", BLOB_DB_BLOB_FILE_SYNC_MICROS);
+  out << ",\"flush_write_bytes\":"
+      << statistics.getTickerCount(FLUSH_WRITE_BYTES)
+      << ",\"compaction_read_bytes\":"
+      << statistics.getTickerCount(COMPACT_READ_BYTES)
+      << ",\"compaction_write_bytes\":"
+      << statistics.getTickerCount(COMPACT_WRITE_BYTES)
+      << ",\"blob_write_bytes\":"
+      << statistics.getTickerCount(BLOB_DB_BLOB_FILE_BYTES_WRITTEN)
+      << ",\"wal_write_bytes\":" << statistics.getTickerCount(WAL_FILE_BYTES)
+      << ",\"stall_us\":" << statistics.getTickerCount(STALL_MICROS)
+      << ",\"backpressure_us\":" << mb.backpressure_micros
+      << ",\"hdd_append_calls\":" << mb.hdd_append_calls
+      << ",\"hdd_append_us\":" << mb.hdd_append_micros
+      << ",\"hdd_sync_calls\":" << mb.hdd_sync_calls
+      << ",\"hdd_sync_us\":" << mb.hdd_sync_micros
+      << ",\"hdd_dirsync_calls\":" << mb.hdd_dirsync_calls
+      << ",\"hdd_dirsync_us\":" << mb.hdd_dirsync_micros
+      << ",\"blob_gc_us\":" << mb.blob_gc_micros
+      << ",\"mirror_wal_append_calls\":" << mirror.calls
+      << ",\"mirror_wal_append_bytes\":" << mirror.bytes
+      << ",\"mirror_wal_append_ns\":" << mirror.ns;
+  return out.str();
+}
