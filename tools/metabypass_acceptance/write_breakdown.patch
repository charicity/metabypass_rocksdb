+enum class BackupIoOperation : size_t {
+  kWalAppend,
+  kSstAppend,
+  kBlobAppend,
+  kOtherAppend,
+  kMetaAppend,
+  kFileSync,
+  kFileFsync,
+  kDirSync,
+  kCount,
+};
+
+class BackupIoMeter {
+ public:
+  template <typename Call>
+  IOStatus Measure(BackupIoOperation operation, size_t bytes, Call call) {
+    const uint64_t begin = Now();
+    auto status = call();
+    const uint64_t elapsed = Now() - begin;
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto& totals = stats_[lossless_cast<size_t>(operation)];
+    ++totals.calls;
+    if (status.ok()) totals.bytes += bytes;
+    totals.ns += elapsed;
+    return status;
+  }
+
+  std::string Fields() {
+    decltype(stats_) snapshot;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      snapshot = stats_;
+    }
+    constexpr std::array<const char*,
+                         static_cast<size_t>(BackupIoOperation::kCount)>
+        names{{"wal_append", "sst_append", "blob_append", "other_append",
+               "meta_append", "file_sync", "file_fsync", "dir_sync"}};
+    std::ostringstream out;
+    for (size_t i = 0; i < names.size(); ++i) {
+      out << ",\"be_backup_" << names[i] << "_calls\":" << snapshot[i].calls
+          << ",\"be_backup_" << names[i] << "_ns\":" << snapshot[i].ns;
+      if (i < lossless_cast<size_t>(BackupIoOperation::kFileSync)) {
+        out << ",\"be_backup_" << names[i] << "_bytes\":" << snapshot[i].bytes;
+      }
+    }
+    return out.str();
+  }
+
+ private:
+  std::mutex mutex_;
+  std::array<FileIoTotals, static_cast<size_t>(BackupIoOperation::kCount)>
+      stats_{};
+};
