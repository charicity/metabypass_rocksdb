+// The writer and sampler use the same mutex as the acknowledged-call snapshot.
+struct WriteBreakdown {
+  uint64_t calls = 0, records = 0, api_ns = 0, wal_ns = 0, memtable_ns = 0;
+
+  void Add(uint64_t count, uint64_t elapsed,
+           const ROCKSDB_NAMESPACE::PerfContext& perf) {
+    ++calls;
+    records += count;
+    api_ns += elapsed;
+    wal_ns += perf.write_wal_time;
+    memtable_ns += perf.write_memtable_time;
+  }
+
+  std::string Fields(uint64_t snapshot_ns) const {
+    return "\"foreground_snapshot_ns\":" + std::to_string(snapshot_ns) +
+           ",\"sampled_calls\":" + std::to_string(calls) +
+           ",\"sampled_records\":" + std::to_string(records) +
+           ",\"sampled_api_ns\":" + std::to_string(api_ns) +
+           ",\"sampled_wal_ns\":" + std::to_string(wal_ns) +
+           ",\"sampled_memtable_ns\":" + std::to_string(memtable_ns);
+  }
+};
+
+struct FileIoTotals {
+  uint64_t calls = 0, bytes = 0, ns = 0;
+};
+
+class MirrorWalMeter {
+ public:
+  void Record(uint64_t elapsed_ns, size_t bytes) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    ++stats_.calls;
+    stats_.bytes += bytes;
+    stats_.ns += elapsed_ns;
+  }
+
+  FileIoTotals Snapshot() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return stats_;
+  }
+
+ private:
+  std::mutex mutex_;
+  FileIoTotals stats_;
+};
